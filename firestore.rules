rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().data.role == 'owner';
    }

    function ownsFamily(familyId) {
      return signedIn() && (request.auth.uid == familyId || isOwner());
    }


    function inLeaderboardCircle(circleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }


    function isCircleFaceoffData(data) {
      return ('persistentCircleRoom' in data)
        && data.persistentCircleRoom == true
        && ('circleId' in data)
        && data.circleId is string;
    }

    function canUseFaceoffRoom(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/faceoffs/$(roomId))
        && (
          !isCircleFaceoffData(get(/databases/$(database)/documents/faceoffs/$(roomId)).data)
          || inLeaderboardCircle(get(/databases/$(database)/documents/faceoffs/$(roomId)).data.circleId)
        );
    }

    function childCanUseCircleFaceoff(roomId, childId) {
      return canUseFaceoffRoom(roomId)
        && isCircleFaceoffData(get(/databases/$(database)/documents/faceoffs/$(roomId)).data)
        && exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childId))
        && get(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childId)).data.leaderboardCircleIds is list
        && get(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childId)).data.leaderboardCircleIds.hasAny([
          get(/databases/$(database)/documents/faceoffs/$(roomId)).data.circleId
        ]);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());

      // Normal family sign-up. The owner account is bootstrapped once in
      // the Firebase console, which bypasses client security rules.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'parent'
        && request.resource.data.familyId == uid
        && getAfter(/databases/$(database)/documents/families/$(uid)).data.ownerUid == uid;

      // Parents cannot promote themselves to owner or move to another family.
      allow update: if isOwner()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.familyId == resource.data.familyId);
      allow delete: if false;
    }

    match /accessCodes/{codeId} {
      // A code can be looked up only when its exact ID is known. Listing all
      // codes is owner-only, so there is no public code directory.
      allow get: if true;
      allow list: if isOwner();
      allow create, delete: if isOwner();

      // Parents may only perform the one atomic redemption change.
      allow update: if isOwner()
        || (signedIn()
          && resource.data.active == true
          && resource.data.uses < resource.data.maxUses
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['uses', 'redeemedUids'])
          && request.resource.data.uses == resource.data.uses + 1
          && request.resource.data.uses <= resource.data.maxUses
          && request.resource.data.redeemedUids.size()
            == resource.data.redeemedUids.size() + 1
          && request.resource.data.redeemedUids.hasAll(resource.data.redeemedUids)
          && request.auth.uid in request.resource.data.redeemedUids
          && !(request.auth.uid in resource.data.redeemedUids));
    }

    match /families/{familyId} {
      allow read, update: if ownsFamily(familyId);

      // Parent family creation must be in the same transaction as a valid
      // access-code redemption. Owners can create their own family directly.
      allow create: if isOwner()
        || (signedIn()
          && request.auth.uid == familyId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.inviteCodeId is string
          && request.auth.uid in getAfter(
            /databases/$(database)/documents/accessCodes/$(request.resource.data.inviteCodeId)
          ).data.redeemedUids);
      allow delete: if isOwner();

      match /children/{childId} {
        allow read: if ownsFamily(familyId);
        allow create, update: if ownsFamily(familyId)
          && request.resource.data.familyId == familyId;
        allow delete: if ownsFamily(familyId);
      }
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /courseVersions/{versionId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Only sanitised competition fields are stored here. Real child names,
    // emails, school stage, mistakes and practice history are not included.
    match /leaderboards/{boardId} {
      allow read: if signedIn();
      allow write: if false;

      match /entries/{childId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.familyId == request.auth.uid
          && request.resource.data.childId == childId
          && exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childId));
        allow delete: if signedIn()
          && (resource.data.familyId == request.auth.uid || isOwner());
      }
    }

    // Private leaderboard circles. The circle document ID is the invite code,
    // so a signed-in family must know the exact code to open the circle.
    // Member documents contain only the family UID; real family/child names are
    // never written into circle metadata or leaderboard entries.
    match /circles/{circleId} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow create: if signedIn()
        && request.resource.data.circleId == circleId
        && request.resource.data.ownerFamilyId == request.auth.uid
        && exists(/databases/$(database)/documents/families/$(request.auth.uid));
      allow update, delete: if isOwner()
        || (signedIn() && resource.data.ownerFamilyId == request.auth.uid);

      match /members/{familyId} {
        allow read: if isOwner()
          || (signedIn() && familyId == request.auth.uid);
        allow create: if signedIn()
          && familyId == request.auth.uid
          && request.resource.data.familyId == request.auth.uid
          && existsAfter(/databases/$(database)/documents/circles/$(circleId))
          && exists(/databases/$(database)/documents/families/$(request.auth.uid));
        allow update: if signedIn()
          && familyId == request.auth.uid
          && request.resource.data.familyId == request.auth.uid;
        allow delete: if isOwner()
          || (signedIn() && familyId == request.auth.uid);
      }

      match /boards/{boardId} {
        allow read, write: if false;

        match /entries/{childId} {
          allow read: if isOwner() || inLeaderboardCircle(circleId);
          allow create, update: if inLeaderboardCircle(circleId)
            && request.resource.data.familyId == request.auth.uid
            && request.resource.data.childId == childId
            && exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childId));
          allow delete: if isOwner()
            || (inLeaderboardCircle(circleId)
              && resource.data.familyId == request.auth.uid);
        }
      }
    }

    // Face-Off rooms. One-off rooms are still code-based. Private circle rooms
    // are permanent and may only be read or changed by families that already
    // belong to that leaderboard circle.
    match /faceoffs/{roomId} {
      allow get: if signedIn()
        && (
          !isCircleFaceoffData(resource.data)
          || inLeaderboardCircle(resource.data.circleId)
        );
      allow list: if false;
      allow create: if signedIn()
        && (
          (isCircleFaceoffData(request.resource.data)
            && inLeaderboardCircle(request.resource.data.circleId))
          || (!isCircleFaceoffData(request.resource.data)
            && request.resource.data.hostFamilyId == request.auth.uid)
        );
      allow update: if signedIn()
        && (
          (!isCircleFaceoffData(resource.data))
          || inLeaderboardCircle(resource.data.circleId)
        );
      allow delete: if isOwner()
        || (signedIn()
          && !isCircleFaceoffData(resource.data)
          && resource.data.hostFamilyId == request.auth.uid);

      match /players/{childId} {
        allow read: if canUseFaceoffRoom(roomId);
        allow create: if signedIn()
          && request.resource.data.familyId == request.auth.uid
          && (
            !isCircleFaceoffData(get(/databases/$(database)/documents/faceoffs/$(roomId)).data)
            || childCanUseCircleFaceoff(roomId, childId)
          );
        allow update: if canUseFaceoffRoom(roomId)
          && ((resource.data.familyId == request.auth.uid
               && request.resource.data.familyId == request.auth.uid)
              || isOwner());
        allow delete: if canUseFaceoffRoom(roomId)
          && (resource.data.familyId == request.auth.uid || isOwner());
      }

      match /rounds/{roundId} {
        allow read: if canUseFaceoffRoom(roomId);
        allow create: if canUseFaceoffRoom(roomId)
          && (
            isCircleFaceoffData(get(/databases/$(database)/documents/faceoffs/$(roomId)).data)
            || get(/databases/$(database)/documents/faceoffs/$(roomId)).data.hostFamilyId == request.auth.uid
          );
        allow update: if canUseFaceoffRoom(roomId);
        allow delete: if isOwner();

        match /results/{childId} {
          allow read: if canUseFaceoffRoom(roomId);
          allow create, update: if canUseFaceoffRoom(roomId)
            && (request.resource.data.familyId == request.auth.uid || isOwner());
          allow delete: if isOwner();
        }
      }
    }

  }
}
