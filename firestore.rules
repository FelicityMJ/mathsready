rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function familyMember(familyId) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, update: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /inviteCodes/{codeId} {
      allow read, write: if false; // server-side callable functions only
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /courseVersions/{versionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /families/{familyId} {
      allow read: if familyMember(familyId) || isAdmin();
      allow write: if isAdmin();
      match /members/{uid} {
        allow read: if familyMember(familyId) || isAdmin();
        allow write: if isAdmin();
      }
      match /children/{childId} {
        allow read, write: if familyMember(familyId) || isAdmin();
        match /attempts/{attemptId} {
          allow read, create: if familyMember(familyId) || isAdmin();
          allow update, delete: if false; // immutable attempt ledger
        }
        match /mastery/{levelId} {
          allow read: if familyMember(familyId) || isAdmin();
          allow write: if false; // production: server function derives/publishes mastery
        }
      }
    }

    match /leaderboards/{levelId}/entries/{childId} {
      allow read: if signedIn();
      allow write: if false; // sanitized entries written by server function
    }

    // Face-Off rooms are read only by authenticated room members.
    // All writes go through Cloud Functions so clients cannot forge scores/winners.
    match /faceoffCodes/{codeId} {
      allow read, write: if false;
    }
    match /faceoffs/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
      match /players/{childId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/faceoffs/$(roomId)).data.memberUids;
        allow write: if false;
      }
      match /rounds/{roundId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/faceoffs/$(roomId)).data.memberUids;
        allow write: if false;
        match /submissions/{childId} {
          allow read: if false; // summaries surfaced through sanitized room state
          allow write: if false;
        }
      }
    }
  }
}
